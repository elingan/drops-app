# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (http://localhost:5173 in dev)
BETTER_AUTH_URL=http://localhost:5173
# libSQL: local file in dev, Turso URL in production (libsql://<db>.turso.io).
# On Vercel the Turso integration provides TURSO_DATABASE_URL / TURSO_AUTH_TOKEN instead.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Initial (single) user: created automatically on first request if no user exists
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=
