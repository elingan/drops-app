# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (http://localhost:5173 in dev)
BETTER_AUTH_URL=http://localhost:5173
# libSQL: local file in dev, Turso URL in production (libsql://<db>.turso.io)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Only used by `npm run seed:user`
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=
